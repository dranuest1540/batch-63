<section class="container-fluid d-flex justify-content-center align-items-center" style="min-height: 100vh;">
	<div class="col-sm-3 col-md-3">
		<div class="card p-4 card-background">
			<div class="mb-3 text-center">
				<img src="../../assets/images/brandred.png" alt="Link Dumbways" class="img-fluid" width="100px">
			</div>

			<h2 class="mb-4 text-center">Please sign up</h2>

			{{#if message}}
				{{!-- Menampilkan pesan error flash --}}
				<div class="alert alert-danger text-center">
					{{message}}
				</div>
			{{/if}}

			<form action="/register/store" method="POST" class="border rounded-3 overflow-hidden form-login">
				<div class="form-floating">
					<input type="email" class="form-control rounded-0" id="inputEmail" name="email" placeholder="Email" required>
					<label for="inputEmail">Email</label>
				</div>
				<div class="form-floating">
					<input type="password" class="form-control rounded-0" id="inputPassword" name="password" placeholder="Password" required>
					<label for="inputPassword">Password</label>
				</div>
				<div class="form-floating">
					<input type="text" class="form-control rounded-0" id="inputName" name="name" placeholder="Name" required>
					<label for="inputName">Name</label>
				</div>
				<div class="d-grid">
					<button class="btn btn-danger btn-lg rounded-0" type="submit">Sign up</button>
				</div>
			</form>
			<p class="mt-3 text-center">
				Already have account? 
				<a href="/login" class="fw-bold link-danger link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover">sign in</a> here.
			</p>
		</div>
	</div>
</section>

<style>
    .form-login .form-floating + .form-floating {
	    margin-top: -1px;
    }
</style>