<section id="login" class="container-fluid d-flex justify-content-center align-items-center" style="min-height: 100vh;">
	<div class="col-sm-3 col-md-3">
		<div class="card p-4 card-background border-0">
			<div class="mb-3 text-center">
				<img src="../../assets/images/logo.png" alt="Logo" class="img-fluid border rounded-4 shadow" width="100px">
			</div>

			<h2 class="mb-4 text-center text-poppins-h2">Please sign in</h2>

			{{#if message}}
				<div class="alert alert-danger text-center">
					{{message}}
				</div>
			{{/if}}

			<form action="/login/auth" method="POST" class="border rounded-3 overflow-hidden form-login">
				<div class="form-floating">
					<input type="email" class="form-control rounded-0" id="inputEmail" name="email" placeholder="Email" required>
					<label for="inputEmail">Email</label>
				</div>
				<div class="form-floating">
					<input type="password" class="form-control rounded-0" id="inputPassword" name="password" placeholder="Password" required>
					<label for="inputPassword">Password</label>
				</div>
				<div class="d-grid">
					<button class="btn btn-dark btn-lg rounded-0" type="submit">Sign in</button>
				</div>
			</form>
			<p class="mt-3 text-center">
				Don't have have account? 
				<a href="/" class="fw-bold link-dark link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover">get back</a> here.
			</p>
		</div>
	</div>
</section>

