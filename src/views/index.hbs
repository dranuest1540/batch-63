<!-- Work Experiences -->
<section id="experience" class="container-fluid col-lg-10 col-md-10 col-sm-10 mb-5">
	<div class="mb-5 d-flex justify-content-between">
		<h2 class="text-poppins-h2">Work Experiences:</h2>
		{{#if user}}
			<a href="/formExperience" class="btn btn-outline-success px-3 py-2">
				<span><i class="fa-solid fa-plus"></i></span>
				Add Project
			</a>
		{{/if}}
	</div>

	{{#each experience}}
	<div class="experience-card d-flex align-items-start bg-white p-4 rounded-4 shadow-sm mb-4">
		<img src="../assets/uploads/works/{{this.company_logo}}" alt="Eptyres" class="experience-logo rounded-3 object-fit-contain bg-white" />
		<div class="ms-4 flex-grow-1">
			<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap">
				<div>
					<h3 class="fw-semibold fs-5 mb-1">{{this.position}}</h3>
					<p class="text-success fs-6 mb-0">{{this.company_name}}</p>
				</div>
				<span class="text-secondary fs-7 mt-2 mt-md-0">{{formatDate this.start_date}} - {{formatDate this.end_date}}</span>
			</div>
			<ul class="text-secondary fs-7 mb-3 ps-3">
				{{#each this.responsibilities}}
				<li class="mb-1">{{this}}</li>
				{{/each}}
			</ul>
			<div class="d-flex flex-wrap gap-2">
				{{#each this.tech_stack}}
				<span class="badge rounded-pill text-bg-secondary px-2 py-1 fs-8">{{this}}</span>
				{{/each}}
			</div>
			{{#if ../user}}
				<div class="mt-3 d-flex gap-2 justify-content-end">
					<a href="/formExperience/edit/{{this.id}}" class="btn btn-outline-warning">
						<i class="fa-solid fa-pen-to-square"></i>
						Edit
					</a>
					<a href="/formExperience/destroy/{{this.id}}" class="btn btn-outline-danger">
						<i class="fa-solid fa-trash"></i>
						Delete
					</a>
				</div>
			{{/if}}
		</div>		
	</div>
	{{/each}}
</section>

<!-- My Projects -->
<section id="project" class="container-fluid col-lg-10 col-md-10 col-sm-10 mb-5">
	<div class="mb-5 d-flex justify-content-between">
		<h2 class="text-poppins-h2">My Projects:</h2>
		{{#if user}}
			<a href="/formProject" class="btn btn-outline-success px-3 py-2">
				<span><i class="fa-solid fa-plus"></i></span>
				Add Project
			</a>
		{{/if}}
	</div>
	<div class="row g-5">
		{{#each project}}
			<div class="col-md-6">
				<div class="card border-0 rounded-4 overflow-hidden">
					<img src="../assets/uploads/projects/{{this.project_image}}" class="card-img-top border-bottom rounded-top-4 object-fit-contain bg-secondary" alt="Sistem Pakar" style="height: 300px; width: 100%;">
					<div class="card-body">
						<h5 class="card-title fw-semibold">{{this.title}}</h5>
						<p class="card-text text-poppins">{{this.description}}</p>
						<div class="d-flex flex-wrap gap-3 mb-3">
							{{#each this.tech_stack}}
								<span class="badge rounded-pill text-bg-secondary px-2 py-1 fs-8">{{this}}</span>
							{{/each}}
						</div>
						<div class="d-flex gap-3 mb-3 fs-8">
							<div class="px-3 py-2">
								{{#if (eq this.repository_status "public")}}
									<a href="{{this.link_repository}}" target="_blank" class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
										<span><i class="fa-brands fa-github"></i></span>
										View on Github
									</a>
								{{else}}
									<a class="text-secondary text-decoration-none disabled" tabindex="-1" aria-disabled="true">
										<span><i class="fa-brands fa-github"></i></span>
										Private Repository
									</a>
								{{/if}}
							</div>
							<div class="px-3 py-2">
								{{#if (eq this.demo_status "available")}}
									<a href="{{this.link_demo}}" target="_blank" class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
										<span><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
										Live Demo
									</a>
								{{else}}
									<a class="text-secondary text-decoration-none disabled" tabindex="-1" aria-disabled="true">
										<span><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
										Demo Unavailable
									</a>
								{{/if}}
							</div>
						</div>
						{{#if ../user}}
							<div class="mt-3 d-flex gap-2 justify-content-end">
								<a href="/formProject/edit/{{this.id}}" class="btn btn-outline-warning">
									<i class="fa-solid fa-pen-to-square"></i>
									Edit
								</a>
								<a href="/formProject/destroy/{{this.id}}" class="btn btn-outline-danger">
									<i class="fa-solid fa-trash"></i>
									Delete
								</a>
							</div>
						{{/if}}
					</div>
				</div>
			</div>
		{{/each}}
	</div>
</section>

